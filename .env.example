# Live vision pass. Without this the server runs in demo mode.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# AUDIT_MODEL=claude-opus-5     # claude-sonnet-5 and claude-haiku-4-5 also work
# AUDIT_EFFORT=medium           # low | medium | high
# PORT=8123

# Pre-launch gate. Set BOTH on the host once deployed — every request needs
# HTTP Basic Auth with this username/password. Leave both unset for local dev
# (the gate is off by default, matching the demo-mode fallback above).
# GATE_USER=ruangkotak
# GATE_PASS=change-me
